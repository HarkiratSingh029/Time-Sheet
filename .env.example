# TS Timesheets — configuration template.
# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Required --------------------------------------------------------------
# Session signing key. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TS_SECRET_KEY=change-me-before-running-anywhere-real

# --- Storage ---------------------------------------------------------------
# The only stateful directory: SQLite database and project file uploads.
TS_DATA_DIR=data
TS_DATABASE_URL=sqlite:///data/app.db

# --- Bootstrap administrator ----------------------------------------------
# Used once, on an empty database, to create the first super user.
TS_ADMIN_EMAIL=admin@example.com
TS_ADMIN_PASSWORD=change-me

# --- Runtime ---------------------------------------------------------------
TS_ENV=development          # development | production
TS_HOST=127.0.0.1
TS_PORT=8000
TS_SESSION_MAX_AGE=86400    # seconds

# --- Email -----------------------------------------------------------------
# Leave TS_SMTP_HOST empty and nothing is ever sent — no queue, no retry, no error.
# In-app badges work regardless; email is the optional half.
TS_SMTP_HOST=
TS_SMTP_PORT=587
TS_SMTP_USERNAME=
TS_SMTP_PASSWORD=
TS_SMTP_USE_TLS=true
TS_SMTP_FROM=ts-timesheets@localhost
TS_DIGEST_HOUR=8          # local hour the daily digest goes out

# --- Project health --------------------------------------------------------
# When a project turns amber and red. The meaning of each colour is fixed; these are
# the numbers behind it (docs/DATA_MODEL.md §4).
TS_HEALTH_AMBER_RATIO=0.90         # schedule or budget consumed
TS_HEALTH_AMBER_APPROVAL_DAYS=7
TS_HEALTH_RED_APPROVAL_DAYS=14

# --- Cloudflare Tunnel -----------------------------------------------------
# The tunnel container starts only when a token is set. Production has no
# inbound ports; the tunnel is the only door.
TS_TUNNEL_TOKEN=
